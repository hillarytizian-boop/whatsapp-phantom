core/engine.js
!core/engine.js.bak

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs
*.log
logs/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.sublime-*

# Termux specific
storage/
.bash_history
.zsh_history

# Temp
tmp/
temp/
*.tmp
