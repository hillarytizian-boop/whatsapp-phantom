function showStatus(message, type = 'info') {
  const icons = {
    info: chalk.blue('[i]'),
    ok: chalk.green('[✓]'),
    warn: chalk.yellow('[!]'),
    error: chalk.red('[✗]'),
    target: chalk.magenta('[→]'),
    ban: chalk.red.bold('[BAN]'),
    attack: chalk.red('[⚡]')
  };
  const icon = icons[type] || icons.info;
  const timestamp = new Date().toLocaleTimeString();
  console.log(`${chalk.gray(`[${timestamp}]`)} ${icon} ${message}`);
}

