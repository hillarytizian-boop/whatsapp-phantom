#!/bin/bash
#
# WhatsApp Phantom - Setup Script
# By Hillary Tizian
#

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m' # No Color
BOLD='\033[1m'

echo -e "${CYAN}${BOLD}"
echo "╔═══════════════════════════════════════════════╗"
echo "║     WhatsApp Phantom v2.0.0 - Setup          ║"
echo "║        By Hillary Tizian                      ║"
echo "╚═══════════════════════════════════════════════╝"
echo -e "${NC}"

# Check if running on Termux
is_termux=false
if [ -d "/data/data/com.termux/files/usr" ]; then
    is_termux=true
    echo -e "${GREEN}[✓] Termux detected${NC}"
fi

# Check Node.js
echo -n "[*] Checking Node.js... "
if command -v node &> /dev/null; then
    node_version=$(node -v)
    echo -e "${GREEN}$node_version${NC}"
else
    echo -e "${RED}NOT FOUND${NC}"
    echo "[!] Installing Node.js..."
    if [ "$is_termux" = true ]; then
        pkg install nodejs -y
    else
        echo "Please install Node.js 17+ from https://nodejs.org"
        exit 1
    fi
fi

# Check npm
echo -n "[*] Checking npm... "
if command -v npm &> /dev/null; then
    npm_version=$(npm -v)
    echo -e "${GREEN}v$npm_version${NC}"
else
    echo -e "${RED}NOT FOUND${NC}"
    exit 1
fi

# Check git
echo -n "[*] Checking git... "
if command -v git &> /dev/null; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${YELLOW}Installing...${NC}"
    if [ "$is_termux" = true ]; then
        pkg install git -y
    fi
fi

# Check proot-distro (Termux only)
if [ "$is_termux" = true ]; then
    echo -n "[*] Checking proot-distro... "
    if command -v proot-distro &> /dev/null; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${YELLOW}Installing...${NC}"
        pkg install proot-distro -y
    fi
    
    # Check Alpine Linux
    echo -n "[*] Checking Alpine Linux (for WPPConnect)... "
    if proot-distro list 2>/dev/null | grep -q "alpine"; then
        echo -e "${GREEN}Installed${NC}"
    else
        echo -e "${YELLOW}Installing Alpine Linux...${NC}"
        proot-distro install alpine
        echo -e "${GREEN}[✓] Alpine Linux installed${NC}"
    fi
    
    # Install Chromium in Alpine
    echo -n "[*] Checking Chromium in Alpine... "
    if proot-distro login alpine sh -c "command -v chromium-browser" &>/dev/null; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${YELLOW}Installing Chromium in Alpine...${NC}"
        proot-distro login alpine -- sh -c "apk add chromium nodejs npm"
        echo -e "${GREEN}[✓] Chromium installed${NC}"
    fi
fi

# Create directory structure
echo -n "[*] Creating directory structure... "
mkdir -p sessions cfg core logs
touch sessions/.gitkeep
echo -e "${GREEN}Done${NC}"

# Install npm dependencies
echo -e "\n${CYAN}[*] Installing npm dependencies...${NC}"
npm install
if [ $? -eq 0 ]; then
    echo -e "${GREEN}[✓] Dependencies installed successfully${NC}"
else
    echo -e "${RED}[✗] npm install failed${NC}"
    exit 1
fi

# Create default config if not exists
if [ ! -f "cfg/accounts.json" ]; then
    echo -e "\n${YELLOW}[*] Creating default accounts.json...${NC}"
    cat > cfg/accounts.json << 'EOF'
{
  "reporters": [],
  "target": null,
  "attack_profile": {
    "vector": "all",
    "intensity": "extreme",
    "duration_minutes": 30
  }
}
EOF
    echo -e "${YELLOW}[!] Edit cfg/accounts.json to add reporter accounts${NC}"
fi

# Make scripts executable
chmod +x phantom.sh 2>/dev/null
chmod +x setup.sh 2>/dev/null

echo -e "\n${GREEN}${BOLD}"
echo "╔═══════════════════════════════════════════════╗"
echo "║       Setup Complete!                        ║"
echo "║                                             ║"
echo "║   Next steps:                               ║"
echo "║   1. Edit cfg/accounts.json with your        ║"
echo "║      reporter phone numbers                  ║"
echo "║   2. Run ./phantom.sh to start               ║"
echo "║                                             ║"
echo "╚═══════════════════════════════════════════════╝"
echo -e "${NC}"
